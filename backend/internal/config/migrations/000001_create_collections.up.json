[
  {
    "create": "support_requests",
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": ["request_id", "client_id", "text", "topic", "priority", "history"],
        "properties": {
          "request_id": { "bsonType": "string" },
          "client_id": { "bsonType": "string" },
          "text": { "bsonType": "string" },
          "topic": { "bsonType": "string" },
          "priority": { "bsonType": "string", "enum": ["low", "medium", "high"] },
          "operator": { "bsonType": "string" },
          "history": {
            "bsonType": "array",
            "items": {
              "bsonType": "object",
              "required": ["timestamp", "message", "from"],
              "properties": {
                "timestamp": { "bsonType": "date" },
                "message": { "bsonType": "string" },
                "from": { "bsonType": "string", "enum": ["client", "operator"] }
              }
            }
          }
        }
      }
    }
  }
]
